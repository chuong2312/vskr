{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VSKR human-curated answer evaluation ground truth JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "expected_answer", "relevant"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "expected_answer": { "type": "string", "minLength": 1 },
    "relevant": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["video_id", "start", "end"],
            "properties": {
              "video_id": { "type": "string", "minLength": 1 },
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["document_id", "section"],
            "properties": {
              "document_id": { "type": "string", "minLength": 1 },
              "section": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
