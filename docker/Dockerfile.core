# Core VSKR image: intentionally uses CPU torch; faster-whisper uses CTranslate2
# and receives the GPU through the NVIDIA runtime.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility HOME=/cache \
    XDG_CACHE_HOME=/cache/xdg HF_HOME=/cache/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh
WORKDIR /app
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
RUN pip install torch --index-url ${TORCH_INDEX}
COPY backend/requirements/base.txt backend/requirements/video.txt \
    backend/requirements/asr.txt backend/requirements/embedding.txt /tmp/requirements/
RUN pip install -r /tmp/requirements/base.txt \
    -r /tmp/requirements/video.txt \
    -r /tmp/requirements/asr.txt \
    -r /tmp/requirements/embedding.txt
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib
COPY configs ./configs
COPY backend/src ./backend/src
ENV PYTHONPATH=/app/backend/src
COPY web ./web
ENTRYPOINT ["python", "-m", "vskr.cli"]
CMD ["serve", "--host", "0.0.0.0"]
