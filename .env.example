# Copy this file to .env, then generate a hash with: vskr admin hash-password
VSKR_ADMIN_USER=
VSKR_ADMIN_PASSWORD_HASH=

# Keep true whenever users connect over HTTPS. false is only accepted on localhost.
VSKR_COOKIE_SECURE=true

# Optional: comma-separated IPs/CIDRs for reverse proxies you control.
# Leave empty to ignore X-Forwarded-For.
VSKR_TRUSTED_PROXIES=

# Optional: set true ONLY after an egress firewall/container blocks every
# non-global IPv4/IPv6 destination. Required (together with
# ingest.guest_url_ingest_enabled) before guests may ingest video URLs.
VSKR_EGRESS_FIREWALL_CONFIRMED=false
