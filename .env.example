# Chép file này thành .env, rồi tạo hash mật khẩu bằng lệnh: vskr admin hash-password
VSKR_ADMIN_USER=
VSKR_ADMIN_PASSWORD_HASH=

# Giữ true khi người dùng vào qua HTTPS. Giá trị false chỉ được chấp nhận trên localhost.
VSKR_COOKIE_SECURE=true

# Tuỳ chọn: IP/CIDR của các reverse proxy bạn quản lý, cách nhau bằng dấu phẩy.
# Để trống thì bỏ qua X-Forwarded-For.
VSKR_TRUSTED_PROXIES=

# Tuỳ chọn: CHỈ đặt true sau khi firewall/container chặn kết nối ra mọi đích
# IPv4/IPv6 không công khai. Phải bật cùng ingest.guest_url_ingest_enabled
# thì khách mới được nạp video bằng URL.
VSKR_EGRESS_FIREWALL_CONFIRMED=false
